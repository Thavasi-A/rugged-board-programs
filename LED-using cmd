
PC23: (pin number 87):
root@ruggedboard: echo 87 > /sys/class/gpio/export
root@ruggedboard: echo out > /sys/class/gpio/PC23/direction
root@ruggedboard: echo 0 > /sys/class/gpio/PC23/value
root@ruggedboard: echo 1 > /sys/class/gpio/PC23/value

